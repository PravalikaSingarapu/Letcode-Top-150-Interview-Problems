class Solution {
    public boolean isPalindrome(int x) {
        int num, rev=0, digit;
        num=x;
        while(num>0){
            digit=num%10;
            rev=rev*10+digit;
            num/=10;
    
        }
        if(x==rev){
            return true;
        }
        return false;
        
    }
}
