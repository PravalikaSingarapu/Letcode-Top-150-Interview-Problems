class Solution {
public:
    int maxPoints(vector<vector<int>>& points) {
        if ( points.size() <= 2)
        return points.size();

        int result = 0;

        for ( int i = 0; i < points.size(); i++){
            unordered_map<string, int> slopeCount;
            int duplicates = 0;
            int currMax = 0;

            for ( int j = i+1; j < points.size(); j++){
                int dx = points[j][0] - points[i][0];
                int dy = points[j][1] - points[i][1];

                if (dx == 0 && dy == 0){
                    duplicates++;
                    continue;
                }

                int g = gcd(dx, dy);
                dx /= g;
                dy /= g;

                if(dx < 0){
                    dx = -dx;
                    dy = -dy;
                }
                if (dx ==0){
                    dy = 1;
                }else if (dy==0){
                    dx = 1;
                }

                string key = to_string(dy) + "/" + to_string(dx);
                slopeCount[key]++;
                currMax = max(currMax, slopeCount[key]);
            }
            result = max(result, currMax + duplicates + 1);
        }
        return result;
        
    }
};
